---
import LinkList from "../components/LinkList.astro";
import { links } from "../links";
---

<div class="flex flex-col justify-center">
    <!-- Header Section -->
    <div class="mb-8 sm:mb-10">
      <h1 
        class="tracking-tight mb-2"
        style="letter-spacing: -0.01em;"
      >
        Joy Paulsen
      </h1>
      <p 
        class="tagline text-base sm:text-lg mb-6"
        style="color: var(--text-secondary);"
      >
        Data Scientist, Engineer, Builder
      </p>
      <p 
        class="text-sm sm:text-base max-w-lg leading-relaxed"
        style="color: var(--text-muted);"
      >
        Currently building tools that make complex information accessible.
      </p>
    </div>

    <!-- Links Grid -->
    <LinkList links={links} />

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600&family=Lora:wght@400;500&display=swap');

  h1 {
    font-family: 'Lora', Georgia, serif;
    font-weight: 400;
    font-size: 2.75rem;
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 3.25rem;
    }
  }

  @media (min-width: 1024px) {
    h1 {
      font-size: 3.75rem;
    }
  }

  .tagline {
    font-family: 'Figtree', system-ui, sans-serif;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
</style>
