---
const {
  href,
  label,
  icon: Icon = null,
  className = "",
} = Astro.props;

const isExternal = href.startsWith("http");
---

<a
  href={href}
  class={`gradient-btn group flex items-center gap-3 py-3.5 px-5 ${className}`}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={label}
>
  {
    Icon && (
      <div class="icon-box w-5 h-5">
        <Icon class="w-full h-full" />
      </div>
    )
  }
  <span class="btn-text">{label}</span>
  {
    isExternal && (
      <svg 
        class="external-arrow w-4 h-4 ml-auto opacity-60 group-hover:opacity-100" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M7 17L17 7M17 7H7M17 7V17" />
      </svg>
    )
  }
</a>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap');

  a {
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .gradient-btn {
    background: linear-gradient(135deg, #faf8f5 0%, #f2ebe2 100%);
    border-radius: 4px;
    border: 1px solid rgba(198, 93, 59, 0.55);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .gradient-btn:hover {
    background: linear-gradient(135deg, #f7ede8 0%, #edd8cc 100%);
    border-color: rgba(198, 93, 59, 0.85);
    transform: translateY(-1px);
  }

  .icon-box {
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .gradient-btn:hover .icon-box {
    color: #c65d3b;
  }

  .btn-text {
    font-family: 'Figtree', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .external-arrow {
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .gradient-btn:hover .external-arrow {
    color: #c65d3b;
    transform: translate(1px, -1px);
  }
</style>
