---
import LinkButton from "./LinkButton.astro";
interface LinkProps {
  href: string;
  label: string;
  icon?: any;
  className?: string;
}
const { links } = Astro.props as { links: LinkProps[] };
---

<section
  id="links"
  class="flex flex-col gap-3 w-full max-w-sm"
>
  {links.map((props: LinkProps) => <LinkButton {...props} />)}
</section>
