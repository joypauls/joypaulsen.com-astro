---
import Intro from "../components/Intro.astro";
import Layout from "../layouts/Layout.astro";
import { InteractiveHeroCanvas } from "../components/AnimationCoolSpace.jsx";
---

<Layout>
  <!-- Mobile: content only, no animation -->
  <div class="lg:hidden h-screen w-full overflow-hidden flex items-center justify-center px-6">
    <div class="w-full max-w-md mx-auto text-center [&_section]:w-full [&_section]:max-w-none [&_a]:w-full">
      <Intro />
    </div>
  </div>

  <!-- Desktop: side by side with interactive animation -->
  <div class="hidden lg:flex h-screen w-full overflow-hidden items-center justify-center px-12 lg:px-24 -mt-8">
    <!-- inner wrapper: stretch both columns to the same height -->
    <div class="flex items-stretch gap-12 max-h-[min(70vh,520px)]">
      <div class="max-w-sm flex flex-col min-h-0">
        <Intro />
      </div>
      <div class="self-stretch min-h-0 min-w-0">
        <InteractiveHeroCanvas client:load />
      </div>
    </div>
  </div>
</Layout>
