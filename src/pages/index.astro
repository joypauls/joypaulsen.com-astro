---
import Intro from "../components/Intro.astro";
import Layout from "../layouts/Layout.astro";
import { InteractiveHeroCanvas } from "../components/AnimationCoolSpace.jsx";
---

<Layout>
  <!-- Mobile: content only, no animation -->
  <div class="lg:hidden h-screen w-full overflow-hidden flex items-center justify-center px-6">
    <div class="w-full max-w-md mx-auto text-center [&_section]:w-full [&_section]:max-w-none [&_a]:w-full">
      <Intro />
    </div>
  </div>

  <!-- Desktop: side by side with interactive animation -->
  <div class="hidden lg:flex h-screen w-full overflow-hidden items-center justify-center gap-12 px-12 lg:px-24 -mt-8">
    <div id="intro-col" class="max-w-sm flex flex-col shrink-0">
      <Intro />
    </div>
    <!-- Frame: explicit square size, no stretch dependency -->
    <div id="anim-col" class="shrink-0 relative" style="width: 0; height: 0;">
      <!-- Static placeholder holds space before React hydrates -->
      <div id="anim-placeholder" style="position:absolute;inset:0;border:1px solid rgba(210,75,50,0.55);border-radius:4px;background:#faf8f5;display:flex;align-items:center;justify-content:center;">
        <div style="width:28px;height:28px;border:2px solid rgba(198,93,59,0.15);border-top-color:rgba(198,93,59,0.5);border-radius:50%;animation:spin 1s linear infinite;"></div>
      </div>
      <!-- React island absolutely fills the same space -->
      <div style="position:absolute;inset:0;">
        <InteractiveHeroCanvas client:load />
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  function syncAnimFrame() {
    const intro = document.getElementById('intro-col');
    const anim = document.getElementById('anim-col');
    if (!intro || !anim) return;
    const h = intro.offsetHeight;
    anim.style.width = h + 'px';
    anim.style.height = h + 'px';
  }
  syncAnimFrame();
  document.fonts.ready.then(syncAnimFrame);
  window.addEventListener('resize', syncAnimFrame);
</script>
